# =====================================================================
# OportunIA - Environment Variables Template
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to git (it's in .gitignore)
# =====================================================================

# ===== LLM Configuration =====
# Local llama.cpp server (your existing setup on srvubuntu01)
LLM_LOCAL_URL=http://srvubuntu01:8080
LLM_LOCAL_MODEL=qwen3.5-4b

# Google Gemini Pro API (use one of your 4 Pro accounts)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-pro-exp

# Default LLM mode: "local" | "gemini" | "auto"
LLM_DEFAULT_MODE=auto

# ===== Google Places API (New) =====
# Get from: https://console.cloud.google.com/
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# ===== Yelp Fusion API =====
# Get from: https://www.yelp.com/developers/v3/manage_app
YELP_API_KEY=your_yelp_api_key_here

# ===== Tavily Search API =====
# Get from: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# ===== Firecrawl =====
# Get from: https://firecrawl.dev
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# ===== Brave Search API =====
# Get from: https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=your_brave_api_key_here

# ===== Application Settings =====
# Origin address for distance calculations (your home)
ORIGIN_ADDRESS=7940 Vandewater St, Eastvale, CA 92880
ORIGIN_LAT=33.9425
ORIGIN_LNG=-117.5632

# Default language: "es" | "en"
DEFAULT_LANGUAGE=es

# Default theme: "light" | "dark"
DEFAULT_THEME=dark
